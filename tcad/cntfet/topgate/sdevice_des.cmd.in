File {
  Grid = "@tdr@"
  Parameter = "sdevice.par"
  Current = "@plot@"
  Plot = "@tdrdat@"
  Output = "@log@"
}

Electrode {
  { Name = "source" Voltage = @BIAS_SOURCE_V@ Schottky Workfunction = @MATERIAL_SOURCE_DRAIN_WORKFUNCTION_EV@ }
  { Name = "drain" Voltage = @BIAS_DRAIN_V@ Schottky Workfunction = @MATERIAL_SOURCE_DRAIN_WORKFUNCTION_EV@ }
  { Name = "gate" Voltage = @BIAS_GATE_INITIAL_V@ Workfunction = @MATERIAL_GATE_WORKFUNCTION_EV@ }
  { Name = "backgate" Voltage = @BIAS_BACKGATE_V@ }
}

Physics {
  AreaFactor = @GEOMETRY_GATE_WIDTH_UM@
  Temperature = @RUN_TEMPERATURE_K@
  Fermi
}

Physics (Material = "CNTNetwork") {
  Mobility(ConstantMobility)
  EffectiveIntrinsicDensity(NoBandGapNarrowing)
  Recombination(SRH)
}

Physics (MaterialInterface = "CNTNetwork/TopDielectric") {
  # FixedCharge carries the TID oxide charge (zero at zero dose). Amphoteric
  # pre-existing interface states use uniform densities in cm-2 eV-1: donors
  # occupy the lower half-gap and acceptors the upper half-gap. Multiple trap
  # specifications require inner parentheses (W-2024.09 User Guide, Ch. 17).
  Traps(
    (Conc = @RUN_FIXED_CHARGE_CM2@ FixedCharge)
    (Donor Uniform EnergyMid = @RUN_INTERFACE_DONOR_ENERGY_MID_EV@ EnergySig = @RUN_INTERFACE_TRAP_ENERGY_WIDTH_EV@ Conc = @RUN_INTERFACE_DIT_CM2EV@ fromMidBandGap eXSection = 1e-14 hXSection = 1e-14)
    (Acceptor Uniform EnergyMid = @RUN_INTERFACE_ACCEPTOR_ENERGY_MID_EV@ EnergySig = @RUN_INTERFACE_TRAP_ENERGY_WIDTH_EV@ Conc = @RUN_INTERFACE_DIT_CM2EV@ fromMidBandGap eXSection = 1e-14 hXSection = 1e-14)
  )
}

Plot {
  Potential ElectricField/Vector
  eCurrent/Vector hCurrent/Vector TotalCurrent/Vector
  eDensity hDensity SpaceCharge
  ConductionBand ValenceBand eQuasiFermi hQuasiFermi
}

Math {
  Extrapolate
  RelErrControl
  Iterations = 30
  NotDamped = 50
  Digits = 5
  ExitOnFailure
  Wallclock
}

Solve {
  Coupled(Iterations = 100 LineSearchDamping = 1e-4) { Poisson }
  Coupled(Iterations = 100) { Poisson Electron Hole }
  Quasistationary(
    InitialStep = 1e-3 Increment = 1.3
    MinStep = 1e-8 MaxStep = 0.05
    Goal { Name = "gate" Voltage = @BIAS_GATE_FINAL_V@ }
  ) {
    Coupled { Poisson Electron Hole }
  }
}
